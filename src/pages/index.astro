---
import Layout from '../layouts/Layout.astro';
import Navbar from '../components/Navbar.astro';
import Hero from '../components/Hero.astro';
import ProjectCard from '../components/ProjectCard.astro';
import SkillBadge from '../components/SkillBadge.astro';

// GitHub API Fetching - Elite Enrichment Engine
let githubRepos = [];
try {
    const response = await fetch('https://api.github.com/users/isanchezv07/repos?sort=pushed&per_page=100');
    if (response.ok) {
        const data = await response.json();
        githubRepos = data
            .filter((repo: any) => !repo.fork && !repo.name.includes('.github') && repo.size > 0)
            .map((repo: any) => {
                const score = (repo.stargazers_count * 10) + (repo.watchers_count * 5) + (repo.forks_count * 2);
                const fallbackDesc = repo.language 
                    ? `Repositorio especializado en ${repo.language}. Desarrollado con un enfoque en la eficiencia y las mejores prácticas de ingeniería.`
                    : "Proyecto de desarrollo original. Consulta el código fuente para explorar la arquitectura y funcionalidades implementadas.";

                return {
                    title: repo.name.replace(/-/g, ' ').toUpperCase(),
                    description: repo.description || fallbackDesc,
                    tech: Array.from(new Set([repo.language, ...(repo.topics || [])])).filter(Boolean),
                    link: repo.html_url,
                    stars: repo.stargazers_count,
                    forks: repo.forks_count,
                    updatedAt: new Date(repo.pushed_at).toLocaleDateString('es-MX', { month: 'short', year: 'numeric' }),
                    isGithub: true,
                    score: score
                };
            })
            .sort((a, b) => b.score - a.score);
    }
} catch (e) {
    console.error("Failed to fetch GitHub repos", e);
}

const allProjects = githubRepos;

const expertise = [
    {
        category: "Backend & Systems",
        skills: [
            { name: "Python", icon: "/icons/python.svg" },
            { name: "Node.js", icon: "/icons/node.svg" },
            { name: "Flask", icon: "/icons/flask.svg" },
            { name: "SQLite", icon: "/icons/sqlite.svg" },
            { name: "OpenCV", icon: "/icons/opencv.svg" }
        ]
    },
    {
        category: "Frontend & Web",
        skills: [
            { name: "React", icon: "/icons/react.svg" },
            { name: "Astro", icon: "/icons/astro.svg" },
            { name: "Tailwind", icon: "/icons/tailwind.svg" },
            { name: "TypeScript", icon: "/icons/typescript.svg" },
            { name: "Vite", icon: "/icons/vite.svg" }
        ]
    },
    {
        category: "DevOps & Tools",
        skills: [
            { name: "Docker", icon: "/icons/docker.svg" },
            { name: "Git", icon: "/icons/git.svg" },
            { name: "JSON Config", icon: "/icons/json.svg" }
        ]
    }
];
---

<Layout title="Isac Sánchez Vargas | Software Engineer">
	<Navbar />
	
	<main class="space-y-40 mb-40">
		<Hero />

		<section id="about" class="container mx-auto px-6">
            <div class="grid lg:grid-cols-2 gap-20 items-start">
                <div class="sticky top-32 space-y-8">
                    <div class="p-8 bg-zinc-900/40 border border-white/5 rounded-3xl shadow-2xl">
                        <h4 class="text-white font-bold mb-6 flex items-center gap-2 text-xs uppercase tracking-[0.2em]">
                            <span class="w-8 h-[1px] bg-blue-500"></span>
                            Mindset Técnico
                        </h4>
                        <div class="grid grid-cols-1 gap-4">
                            {[
                                { t: "Legibilidad", d: "El código se lee más veces de las que se escribe." },
                                { t: "Eficiencia", d: "Menos código, más impacto. Soluciones que escalan." }
                            ].map(p => (
                                <div class="p-4 rounded-xl border border-white/5 bg-zinc-950/30">
                                    <span class="text-blue-500 text-[10px] font-black block mb-1 uppercase tracking-widest">{p.t}</span>
                                    <p class="text-[11px] text-zinc-500 leading-relaxed font-medium">{p.d}</p>
                                </div>
                            ))}
                        </div>
                    </div>
                </div>

                <div class="space-y-12">
                    <div>
                        <h2 class="text-xs font-mono text-blue-500 uppercase tracking-[0.3em] mb-4">_quien_soy.sh</h2>
                        <h3 class="text-5xl md:text-6xl font-bold text-white tracking-tighter leading-tight">
                            Desarrollador <br/> 
                            <span class="text-zinc-500 italic font-light">enfocado en resultados.</span>
                        </h3>
                    </div>
                    <div class="space-y-8 text-lg text-zinc-400 leading-relaxed font-light">
                        <p>
                            Mi enfoque es pragmático: utilizo la tecnología como una herramienta para resolver problemas complejos de la forma más elegante y estable posible.
                        </p>
                        <p>
                            Desde la automatización de procesos hasta el diseño de arquitecturas para robótica, cada proyecto es una oportunidad para optimizar y crear valor real.
                        </p>
                    </div>
                </div>
            </div>
		</section>

		<!-- Icon-Only Skills Grid: Using local SVGs -->
		<section id="skills" class="container mx-auto px-6">
			<div class="mb-20">
				<h2 class="text-xs font-mono text-blue-500 uppercase tracking-[0.3em] mb-4">Ecosistema</h2>
				<h3 class="text-4xl font-bold text-white">Stack <span class="text-zinc-500">Técnico.</span></h3>
			</div>
			
			<div class="grid md:grid-cols-3 gap-16">
				{expertise.map(group => (
					<div class="space-y-8">
						<div class="flex items-center gap-4">
							<h4 class="text-zinc-500 font-mono text-[10px] tracking-[0.2em] uppercase">{group.category}</h4>
							<div class="h-px bg-white/5 flex-grow"></div>
						</div>
						<div class="flex flex-wrap gap-4">
							{group.skills.map(skill => (
								<SkillBadge name={skill.name} iconPath={skill.icon} />
							))}
						</div>
					</div>
				))}
			</div>
		</section>

		<!-- All Projects Section -->
		<section id="projects" class="container mx-auto px-6">
			<div class="flex flex-col md:flex-row justify-between items-end gap-8 mb-16">
				<div>
                    <h2 class="text-xs font-mono text-blue-500 uppercase tracking-[0.3em] mb-4">Proyectos</h2>
				    <h3 class="text-4xl font-bold text-white">Actividad <span class="text-zinc-500">Reciente.</span></h3>
                </div>
                <p class="text-zinc-500 max-w-sm text-xs font-mono uppercase tracking-widest">
                    Live from GitHub // Total: <span id="project-count">{allProjects.length}</span>
                </p>
			</div>
			<div id="projects-grid" class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-6">
				{allProjects.map(project => (
					<ProjectCard {...project} />
				))}
			</div>
		</section>

		<section id="contact" class="container mx-auto px-6 py-20 text-center">
            <div class="max-w-2xl mx-auto py-20 border border-white/5 rounded-[3rem] bg-zinc-900/10">
                <h2 class="text-5xl font-bold text-white mb-8 tracking-tighter">¿Hablamos?</h2>
                <a href="mailto:isanchezv.dev@gmail.com" class="inline-block px-12 py-5 bg-white text-black font-extrabold rounded-full hover:bg-blue-600 hover:text-white transition-all duration-500 transform hover:scale-105 shadow-2xl">
                    Establecer Conexión
                </a>
            </div>
		</section>
	</main>

	<footer class="py-20 text-center font-mono text-[9px] tracking-[0.3em] text-zinc-600 uppercase border-t border-white/5">
		&copy; 2024 isanchez // built_with_astro // all_systems_operational
	</footer>
</Layout>

<script>
    // Client-side Refresh - Real-time Synchronization
    async function refreshProjects() {
        const grid = document.getElementById('projects-grid');
        if (!grid) return;

        try {
            const response = await fetch('https://api.github.com/users/isanchezv07/repos?sort=pushed&per_page=100');
            if (!response.ok) return;

            const data = await response.json();
            const githubRepos = data
                .filter((repo: any) => !repo.fork && !repo.name.includes('.github') && repo.size > 0)
                .map((repo: any) => {
                    const score = (repo.stargazers_count * 10) + (repo.watchers_count * 5) + (repo.forks_count * 2);
                    const fallbackDesc = repo.language 
                        ? `Repositorio especializado en ${repo.language}. Desarrollado con un enfoque en la eficiencia y las mejores prácticas de ingeniería.`
                        : "Proyecto de desarrollo original. Consulta el código fuente para explorar la arquitectura y funcionalidades implementadas.";

                    return {
                        title: repo.name.replace(/-/g, ' ').toUpperCase(),
                        description: repo.description || fallbackDesc,
                        tech: Array.from(new Set([repo.language, ...(repo.topics || [])])).filter(Boolean),
                        link: repo.html_url,
                        stars: repo.stargazers_count,
                        forks: repo.forks_count,
                        updatedAt: new Date(repo.pushed_at).toLocaleDateString('es-MX', { month: 'short', year: 'numeric' }),
                        score: score
                    };
                })
                .sort((a, b) => b.score - a.score);

            // Solo actualizamos si hay cambios significativos o para asegurar frescura total
            if (githubRepos.length > 0) {
                const countElement = document.getElementById('project-count');
                if (countElement) countElement.textContent = githubRepos.length.toString();

                grid.innerHTML = githubRepos.map(project => `
                    <article class="group relative border border-white/5 bg-zinc-900/40 rounded-2xl p-6 md:p-8 flex flex-col h-full overflow-hidden transition-all duration-500">
                        <div class="absolute inset-0 bg-gradient-to-br from-blue-600/5 to-transparent opacity-0 group-hover:opacity-100 transition-opacity duration-500"></div>
                        <div class="relative z-10 flex flex-col h-full">
                            <div class="flex justify-between items-start mb-6">
                                <div class="flex gap-3">
                                    ${project.stars > 0 ? `
                                        <div class="flex items-center gap-1.5 px-2 py-1 rounded-md bg-yellow-500/5 border border-yellow-500/10 text-[10px] font-bold text-yellow-500/80">
                                            <svg class="w-3 h-3" fill="currentColor" viewBox="0 0 20 20"><path d="M9.049 2.927c.3-.921 1.603-.921 1.902 0l1.07 3.292a1 1 0 00.95.69h3.462c.969 0 1.371 1.24.588 1.81l-2.8 2.034a1 1 0 00-.364 1.118l1.07 3.292c.3.921-.755 1.688-1.54 1.118l-2.8-2.034a1 1 0 00-1.175 0l-2.8 2.034c-.784.57-1.838-.197-1.539-1.118l1.07-3.292a1 1 0 00-.364-1.118L2.98 8.72c-.783-.57-.38-1.81.588-1.81h3.461a1 1 0 00.951-.69l1.07-3.292z"/></svg>
                                            ${project.stars}
                                        </div>
                                    ` : ''}
                                    ${project.forks > 0 ? `
                                        <div class="flex items-center gap-1.5 px-2 py-1 rounded-md bg-blue-500/5 border border-blue-500/10 text-[10px] font-bold text-blue-400/80">
                                            <svg class="w-3 h-3" fill="currentColor" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2" fill="none"><path d="M6 3v12s0 2 2 2h4M18 7v12s0 2-2 2h-4M12 11v10" stroke-linecap="round" stroke-linejoin="round"/></svg>
                                            ${project.forks}
                                        </div>
                                    ` : ''}
                                </div>
                                <span class="text-[9px] font-mono text-zinc-600 uppercase tracking-widest">${project.updatedAt}</span>
                            </div>
                            <h3 class="text-lg font-bold text-white mb-3 group-hover:text-blue-400 transition-colors leading-tight">${project.title}</h3>
                            <p class="text-zinc-500 text-sm mb-8 leading-relaxed line-clamp-4 flex-grow">${project.description}</p>
                            <div class="flex flex-wrap gap-1.5 mb-8">
                                ${project.tech.slice(0, 6).map((t: string) => `
                                    <span class="text-[9px] font-mono text-zinc-400 bg-white/5 px-2 py-0.5 rounded-sm border border-white/5 uppercase tracking-tighter">${t}</span>
                                `).join('')}
                                ${project.tech.length > 6 ? `<span class="text-[9px] font-mono text-zinc-600 px-2 py-0.5 italic">+${project.tech.length - 6} más</span>` : ''}
                            </div>
                            <div class="pt-4 border-t border-white/5 flex items-center justify-between">
                                <a href="${project.link}" target="_blank" class="inline-flex items-center gap-2 text-[10px] font-black uppercase tracking-widest text-zinc-400 hover:text-white transition-colors group/link">
                                    Source Code
                                    <svg class="w-3 h-3 group-hover/link:translate-x-1 transition-transform" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="3">
                                        <path d="M13 7l5 5m0 0l-5 5m5-5H6" />
                                    </svg>
                                </a>
                                <div class="opacity-20 group-hover:opacity-100 transition-opacity">
                                    <svg class="w-4 h-4 text-white" fill="currentColor" viewBox="0 0 24 24"><path d="M12 0c-6.626 0-12 5.373-12 12 0 5.302 3.438 9.8 8.207 11.387.599.111.793-.261.793-.577v-2.234c-3.338.726-4.041-1.416-4.041-1.416-.546-1.387-1.333-1.756-1.333-1.756-1.089-.745.083-.729.083-.729 1.205.084 1.839 1.237 1.839 1.237 1.07 1.834 2.807 1.304 3.492.997.107-.775.418-1.305.762-1.604-2.665-.305-5.467-1.334-5.467-5.931 0-1.311.469-2.381 1.236-3.221-.124-.303-.535-1.524.117-3.176 0 0 1.008-.322 3.301 1.23.957-.266 1.983-.399 3.003-.404 1.02.005 2.047.138 3.006.404 2.291-1.552 3.297-1.23 3.297-1.23.653 1.653.242 2.874.118 3.176.77.84 1.235 1.911 1.235 3.221 0 4.609-2.807 5.624-5.479 5.921.43.372.823 1.102.823 2.222v3.293c0 .319.192.694.801.576 4.765-1.589 8.199-6.086 8.199-11.386 0-6.627-5.373-12-12-12z"/></svg>
                                </div>
                            </div>
                        </div>
                    </article>
                `).join('');
            }
        } catch (e) {
            console.error("Failed to refresh projects", e);
        }
    }

    // Initialize refresh after page load
    window.addEventListener('load', refreshProjects);
</script>
