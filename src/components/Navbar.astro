---
const navItems = [
    { name: "Proyectos", href: "#projects" },
    { name: "Sobre Mí", href: "#about" },
    { name: "Stack", href: "#skills" },
    { name: "Contacto", href: "#contact" },
];
---
<nav class="fixed top-0 left-0 right-0 z-[100] border-b border-white/5 bg-[#080808]/50 backdrop-blur-xl">
    <div class="container mx-auto px-6 h-16 flex justify-between items-center">
        <a href="/" class="text-lg font-bold tracking-tighter text-white">
            isanchez<span class="text-blue-500">.</span>
        </a>
        
        <div class="hidden md:flex items-center gap-1 bg-white/5 p-1 rounded-full border border-white/5">
            {navItems.map(item => (
                <a href={item.href} class="px-4 py-1.5 text-xs font-medium text-zinc-500 hover:text-white hover:bg-white/5 rounded-full transition-all">
                    {item.name}
                </a>
            ))}
        </div>

        <a href="mailto:isanchezv.dev@gmail.com" class="hidden md:block text-[10px] font-black uppercase tracking-widest text-zinc-400 hover:text-white transition-colors">
            Hablemos
        </a>
    </div>
</nav>
