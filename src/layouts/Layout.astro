---
import '../styles/global.css';

interface Props {
	title: string;
	description?: string;
}

const { title, description = "Isac Sánchez Vargas | Software Dev" } = Astro.props;
---

<!doctype html>
<html lang="es" class="scroll-smooth dark">
	<head>
		<meta charset="UTF-8" />
		<meta name="description" content={description} />
		<meta name="viewport" content="width=device-width" />
		<link rel="icon" type="image/svg+xml" href="/favicon.svg" />
		<meta name="generator" content={Astro.generator} />
		<title>{title}</title>
		<link rel="preconnect" href="https://fonts.googleapis.com">
		<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
		<link href="https://fonts.googleapis.com/css2?family=Space+Grotesk:wght@300;400;500;600;700&family=JetBrains+Mono:wght@400;500&display=swap" rel="stylesheet">
	</head>
	<body class="bg-[#080808] text-zinc-400 font-sans antialiased selection:bg-blue-500/30 overflow-x-hidden">
		<!-- Ultra-thin Grid Background -->
		<div class="fixed inset-0 -z-10 bg-[linear-gradient(to_right,#ffffff05_1px,transparent_1px),linear-gradient(to_bottom,#ffffff05_1px,transparent_1px)] bg-[size:40px_40px]"></div>
		
		<!-- Subtle Glows -->
		<div class="fixed top-0 left-1/2 -translate-x-1/2 -z-10 h-[400px] w-[800px] bg-blue-600/10 blur-[120px] rounded-full"></div>

		<slot />
	</body>
</html>
